import math
import random
import tkinter as tk
from tkinter import messagebox

class TicTacToeApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Tic-Tac-Toe App")
        self.root.geometry("400x550")
        self.root.configure(bg="#1e1e2e")
        self.root.resizable(False, False)

        # Game State
        self.board = [' ' for _ in range(9)]
        self.human = 'o'
        self.ai = 'x'
        self.scores = {"player": 0, "ai": 0, "ties": 0}
        self.difficulty = tk.StringVar(value="Impossible")

        self.create_widgets()
        self.reset_board()

    def create_widgets(self):
        # Scoreboard
        self.score_frame = tk.Frame(self.root, bg="#1e1e2e", pady=10)
        self.score_frame.pack(fill="x")

        self.score_label = tk.Label(
            self.score_frame, 
            text="Player: 0  |  AI: 0  |  Ties: 0", 
            font=("Helvetica", 14, "bold"), 
            fg="#cdd6f4", 
            bg="#1e1e2e"
        )
        self.score_label.pack()

        # Difficulty Selector
        self.diff_frame = tk.Frame(self.root, bg="#1e1e2e", pady=5)
        self.diff_frame.pack()

        tk.Label(self.diff_frame, text="Difficulty: ", font=("Helvetica", 10), fg="#a6adc8", bg="#1e1e2e").pack(side="left")
        diff_menu = tk.OptionMenu(self.diff_frame, self.difficulty, "Easy", "Medium", "Impossible", command=self.change_difficulty)
        diff_menu.configure(bg="#313244", fg="#cdd6f4", activebackground="#45475a", highlightthickness=0, bd=0)
        diff_menu["menu"].configure(bg="#313244", fg="#cdd6f4")
        diff_menu.pack(side="left")

        # Game Grid
        self.grid_frame = tk.Frame(self.root, bg="#1e1e2e", padx=20, pady=20)
        self.grid_frame.pack(expand=True, fill="both")

        self.buttons = []
        for i in range(9):
            btn = tk.Button(
                self.grid_frame, 
                text=" ", 
                font=("Helvetica", 24, "bold"), 
                bg="#313244", 
                fg="#cdd6f4", 
                activebackground="#45475a",
                activeforeground="#cdd6f4",
                bd=0, 
                width=3, 
                height=1,
                command=lambda idx=i: self.human_move(idx)
            )
            row, col = i // 3, i % 3
            btn.grid(row=row, column=col, padx=5, pady=5, sticky="nsew")
            self.buttons.append(btn)

        for i in range(3):
            self.grid_frame.rowconfigure(i, weight=1)
            self.grid_frame.columnconfigure(i, weight=1)

        # Control Panel
        self.control_frame = tk.Frame(self.root, bg="#1e1e2e", pady=15)
        self.control_frame.pack(fill="x")

        reset_btn = tk.Button(
            self.control_frame, 
            text="Reset Game", 
            font=("Helvetica", 12, "bold"), 
            bg="#f38ba8", 
            fg="#11111b",
            activebackground="#e06c75",
            bd=0, 
            padx=20, 
            pady=8,
            command=self.reset_game
        )
        reset_btn.pack()

    # --- Game Logic Engine ---
    
    def is_winner(self, b, player):
        wins = [(0,1,2), (3,4,5), (6,7,8), (0,3,6), (1,4,7), (2,5,8), (0,4,8), (2,4,6)]
        return any(b[a] == b[b_] == b[c] == player for a, b_, c in wins)

    def is_board_full(self, b):
        return ' ' not in b

    def minimax(self, b, depth, is_maximizing):
        if self.is_winner(b, self.ai): return 10 - depth
        if self.is_winner(b, self.human): return depth - 10
        if self.is_board_full(b): return 0

        if is_maximizing:
            best_score = -math.inf
            for i in range(9):
                if b[i] == ' ':
                    b[i] = self.ai
                    score = self.minimax(b, depth + 1, False)
                    b[i] = ' '
                    best_score = max(score, best_score)
            return best_score
        else:
            best_score = math.inf
            for i in range(9):
                if b[i] == ' ':
                    b[i] = self.human
                    score = self.minimax(b, depth + 1, True)
                    b[i] = ' '
                    best_score = min(score, best_score)
            return best_score

    def get_best_move(self):
        best_score = -math.inf
        move = -1
        for i in range(9):
            if self.board[i] == ' ':
                self.board[i] = self.ai
                score = self.minimax(self.board, 0, False)
                self.board[i] = ' '
                if score > best_score:
                    best_score = score
                    move = i
        return move

    def ai_move(self):
        empty_indices = [i for i, val in enumerate(self.board) if val == ' ']
        if not empty_indices:
            return

        diff = self.difficulty.get()
        
        # Difficulty Logic Switch
        if diff == "Easy":
            move = random.choice(empty_indices)
        elif diff == "Medium":
            if random.random() < 0.4:  # 40% chance to make a silly mistake
                move = random.choice(empty_indices)
            else:
                move = self.get_best_move()
        else:  # Impossible
            move = self.get_best_move()

        if move != -1:
            self.board[move] = self.ai
            self.buttons[move].config(text=self.ai.upper(), fg="#89b4fa", state="disabled")
            self.check_game_over()

    def human_move(self, idx):
        if self.board[idx] == ' ':
            self.board[idx] = self.human
            self.buttons[idx].config(text=self.human.upper(), fg="#a6e3a1", state="disabled")
            
            if not self.check_game_over():
                self.root.after(400, self.ai_move)  # Slipped half a second delay to feel realistic

    def check_game_over(self):
        if self.is_winner(self.board, self.human):
            self.scores["player"] += 1
            self.end_round("You Win! 🎉")
            return True
        elif self.is_winner(self.board, self.ai):
            self.scores["ai"] += 1
            self.end_round("AI Wins! 🤖")
            return True
        elif self.is_board_full(self.board):
            self.scores["ties"] += 1
            self.end_round("It's a Tie! 🤝")
            return True
        return False

    def end_round(self, message):
        self.score_label.config(text=f"Player: {self.scores['player']}  |  AI: {self.scores['ai']}  |  Ties: {self.scores['ties']}")
        for btn in self.buttons:
            btn.config(state="disabled")
        messagebox.showinfo("Game Over", message)
        self.reset_board()

    def reset_board(self):
        self.board = [' ' for _ in range(9)]
        for btn in self.buttons:
            btn.config(text=" ", state="normal", bg="#313244")
        
        # AI moves first if Impossible mode is set, matching your original code rule
        if self.difficulty.get() == "Impossible":
            self.ai_move()

    def reset_game(self):
        self.scores = {"player": 0, "ai": 0, "ties": 0}
        self.score_label.config(text="Player: 0  |  AI: 0  |  Ties: 0")
        self.reset_board()

    def change_difficulty(self, val):
        self.reset_game()

if __name__ == "__main__":
    window = tk.Tk()
    app = TicTacToeApp(window)
    window.mainloop()
